# .env.example  →  복사 후 .env 로 저장하고 실제 값 입력
# cp .env.example .env

# ── 한국투자증권 KIS API ──────────────────────────────────────
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_앱시크릿_입력
KIS_ACCOUNT=계좌번호-뒤4자리   # 예: 50123456-01
KIS_MOCK=false                  # 모의투자면 true

# ── Discord ──────────────────────────────────────────────────
# 채널 설정 → 웹후크 → 웹후크 URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYY
# (선택) 봇 토큰 — 슬래시 커맨드 등 확장 시 사용
DISCORD_BOT_TOKEN=
